# =============================================================================
# Cybersecurity Repository .gitignore
# Prevents accidental leaks of credentials, sensitive telemetry, large disk images
# =============================================================================

# Credentials, Keys & Secrets (CRITICAL SECURITY HYGIENE)
*.env
*.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.txt
passwords.txt
api_keys.json
secrets.yaml

# Virtual Machines & Memory Dumps (Extremely large binary files)
*.vmdk
*.vdi
*.qcow2
*.ova
*.ovf
*.raw
*.dd
*.dmp
*.vmem
*.mem
*.E01
*.001

# Large Packet Captures (>50MB) - Keep sample PCAPs only
# *.pcap
# *.pcapng

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
dist/
*.egg-info/

# Operating System Junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
